{
  "uid": "devbox-host",
  "title": "agent-devbox / Host",
  "description": "Confinement services, secrets, CA and host resources.",
  "tags": [
    "agent-devbox"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "panels": [
    {
      "id": 9,
      "title": "Services",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "devbox-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 18,
        "h": 5
      },
      "targets": [
        {
          "expr": "max by (unit) (devbox_unit_active)",
          "instant": true,
          "legendFormat": "{{unit}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "devbox-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "up",
                  "color": "green"
                }
              }
            }
          ]
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 18,
      "title": "Egress policy loaded",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "devbox-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "devbox_egress_policy_loaded",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "devbox-prometheus"
          }
        }
      ],
      "description": "nftables table inet agent_egress present. If 0, the agent is not confined: sudo systemctl restart agent-egress-firewall",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "MISSING",
                  "color": "red"
                },
                "1": {
                  "text": "loaded",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      }
    },
    {
      "id": 10,
      "title": "Egress policy mode",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "devbox-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "max by (mode) (devbox_mode)",
          "instant": true,
          "legendFormat": "{{mode}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "devbox-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "name"
      }
    },
    {
      "id": 11,
      "title": "CA: days left",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "devbox-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "(devbox_ca_expiry_timestamp_seconds - time()) / 86400",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "devbox-prometheus"
          },
          "legendFormat": "days left"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          },
          "decimals": 0
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      }
    },
    {
      "id": 12,
      "title": "Secrets stored",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "devbox-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "devbox_secret_present",
          "instant": true,
          "legendFormat": "{{name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "devbox-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "missing",
                  "color": "red"
                },
                "1": {
                  "text": "stored",
                  "color": "green"
                }
              }
            }
          ]
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 13,
      "title": "Secret age",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "devbox-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "(time() - devbox_secret_mtime_seconds) / 86400",
          "instant": true,
          "legendFormat": "{{name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "devbox-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 330
              }
            ]
          },
          "decimals": 0,
          "displayName": "${__field.labels.name} (days)"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 14,
      "title": "CPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "devbox-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval]))",
          "legendFormat": "used",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "devbox-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "id": 15,
      "title": "Memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "devbox-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
          "legendFormat": "used",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "devbox-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "id": 16,
      "title": "Disk used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "devbox-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes",
          "legendFormat": "{{mountpoint}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "devbox-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "id": 17,
      "title": "Network",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "devbox-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (device) (rate(node_network_receive_bytes_total{device!~\"lo|veth.*|docker.*\"}[$__rate_interval]))",
          "legendFormat": "{{device}} in",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "devbox-prometheus"
          }
        },
        {
          "expr": "-sum by (device) (rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|docker.*\"}[$__rate_interval]))",
          "legendFormat": "{{device}} out",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "devbox-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      }
    }
  ],
  "templating": {
    "list": []
  }
}