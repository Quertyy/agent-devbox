#!/usr/bin/python3 -I
# Managed by agent-devbox (monitoring role).
"""Read-only query gateway for the agent: 127.0.0.1:{{ devbox_obs_gateway_port }}.

Only Prometheus and Loki *query* endpoints are forwarded; everything else
(Loki push/delete, Prometheus admin/lifecycle/remote-write, Grafana) is
refused with 403. Same paths as the upstream APIs, so standard clients work:
  curl 'http://127.0.0.1:{{ devbox_obs_gateway_port }}/loki/api/v1/query_range?query=...'
  curl 'http://127.0.0.1:{{ devbox_obs_gateway_port }}/api/v1/query?query=up'
"""
import http.server
import re
import socketserver
import threading
import urllib.error
import urllib.request

LISTEN = ("127.0.0.1", {{ devbox_obs_gateway_port }})
LOKI = "http://127.0.0.1:{{ monitoring_ports.loki }}"
PROMETHEUS = "http://127.0.0.1:{{ monitoring_ports.prometheus }}"
MAX_BODY = 1 << 20
ROUTES = [
    (re.compile(r"^/loki/api/v1/(query|query_range|labels|label/[^/]+/values|series|index/stats|index/volume|detected_labels|detected_fields)$"), LOKI),
    (re.compile(r"^/api/v1/(query|query_range|query_exemplars|series|labels|label/[^/]+/values|metadata|targets|targets/metadata|rules|alerts|status/buildinfo)$"), PROMETHEUS),
]
FORWARD_HEADERS = ("Content-Type", "Accept", "Accept-Encoding")
# Never pick up proxy settings from the environment: upstreams are local.
OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))


# At most this many queries in flight: the agent must not be able to saturate
# Prometheus or Loki (and the host) with expensive queries.
SLOTS = threading.BoundedSemaphore(4)


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "devbox-obs-gateway"

    def _forward(self):
        if not SLOTS.acquire(blocking=False):
            self.send_error(429, "too many concurrent queries")
            return
        try:
            self._forward_one()
        finally:
            SLOTS.release()

    def _forward_one(self):
        path, _, query = self.path.partition("?")
        # Upstreams decode and clean paths: refuse anything that could be
        # rewritten into another endpoint after this check.
        if "%" in path or "/." in path or "//" in path:
            self.send_error(403, "read-only gateway: endpoint not allowed")
            return
        upstream = next((u for rx, u in ROUTES if rx.match(path)), None)
        if upstream is None:
            self.send_error(403, "read-only gateway: endpoint not allowed")
            return
        body = None
        if self.command == "POST":
            length = int(self.headers.get("Content-Length") or 0)
            if length > MAX_BODY:
                self.send_error(413)
                return
            body = self.rfile.read(length)
        req = urllib.request.Request(upstream + self.path, data=body, method=self.command)
        for h in FORWARD_HEADERS:
            if self.headers.get(h):
                req.add_header(h, self.headers[h])
        try:
            resp = OPENER.open(req, timeout=60)
        except urllib.error.HTTPError as e:
            resp = e
        except OSError as e:
            self.send_error(502, f"upstream unavailable: {e.__class__.__name__}")
            return
        with resp:
            self.send_response(resp.status)
            for h in ("Content-Type", "Content-Encoding"):
                if resp.headers.get(h):
                    self.send_header(h, resp.headers[h])
            data = resp.read()
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

    do_GET = _forward
    do_POST = _forward

    def log_message(self, fmt, *args):
        pass  # requests are not logged: query strings may be large


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True


if __name__ == "__main__":
    Server(LISTEN, Handler).serve_forever()
