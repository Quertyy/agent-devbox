; Managed by agent-devbox (monitoring role).
[server]
http_addr = {{ devbox_grafana_listen.rsplit(':', 1)[0] | replace('[', '') | replace(']', '') }}
http_port = {{ devbox_grafana_listen.rsplit(':', 1)[1] }}
{% if __devbox_grafana_public_url is defined %}
; Published on the tailnet by `tailscale serve`.
root_url = {{ __devbox_grafana_public_url }}
{% endif %}

[paths]
data = /var/lib/devbox-grafana
logs = /var/lib/devbox-grafana/log
plugins = /var/lib/devbox-grafana/plugins
provisioning = {{ __devbox_config_dir }}/monitoring/grafana/provisioning

[security]
admin_user = admin
; admin_password comes from GF_SECURITY_ADMIN_PASSWORD ({{ __devbox_config_dir }}/grafana.env)
cookie_secure = {{ 'true' if __devbox_grafana_public_url is defined else 'false' }}
disable_gravatar = true

[users]
allow_sign_up = false

[auth.anonymous]
enabled = false

[analytics]
reporting_enabled = false
check_for_updates = false
check_for_plugin_updates = false

[plugins]
preinstall_disabled = true

[news]
news_feed_enabled = false
