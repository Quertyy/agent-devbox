#!/bin/bash
# Managed by agent-devbox (iron_proxy role).
# Store a secret for iron-proxy, then reload:  sudo iron-proxy-set-secret <name>
# The value comes from a hidden prompt (or stdin) and is never echoed. Run it
# from an admin terminal, never from an agent session.
set -euo pipefail
[[ $EUID -eq 0 ]] || { echo "iron-proxy-set-secret: run with sudo" >&2; exit 1; }
name=${1:-}
declared="{{ __devbox_secrets | map(attribute='name') | join(' ') }}"
case " $declared " in
  *" $name "*) ;;
  *) echo "usage: iron-proxy-set-secret <name>   (declared: $declared)" >&2; exit 2 ;;
esac
dir={{ __devbox_secrets_dir }}
if [[ -t 0 ]]; then
  IFS= read -rs -p "Value for '$name' (hidden): " value; echo
  # A token copied from a wrapped terminal line arrives as several lines:
  # drain them so no fragment is left for the shell (and its history).
  while IFS= read -rs -t 0.3 extra; do value+=$extra; done
else
  IFS= read -r value || true
fi
# Tokens never contain whitespace; strip any picked up while copying.
value=${value//[[:space:]]/}
[[ -n $value ]] || { echo "iron-proxy-set-secret: empty value, nothing written" >&2; exit 1; }
case $name in
{% for s in __devbox_secrets if s.pattern is defined %}
  {{ s.name }}) re={{ s.pattern | quote }} ;;
{% endfor %}
  *) re='' ;;
esac
if [[ -n $re && ! $value =~ $re ]]; then
  echo "iron-proxy-set-secret: value does not look like a '$name' secret, nothing written" >&2
  exit 1
fi
tmp=$(mktemp "$dir/.${name}.XXXXXX")
trap 'rm -f "$tmp"' EXIT
printf '%s' "$value" > "$tmp"   # exact value, no newline: the file source does not trim
unset value
chown root:{{ devbox_proxy_user }} "$tmp"
chmod 0440 "$tmp"
mv -f "$tmp" "$dir/$name"
trap - EXIT
echo "secret '$name' stored ($(stat -c %s "$dir/$name") bytes)"
logger -t iron-proxy-set-secret "secret '$name' updated by ${SUDO_USER:-root}"
if systemctl is-active --quiet iron-proxy; then
  /usr/local/sbin/iron-proxy-reload
fi
